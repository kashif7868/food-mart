# =====================================================
# FoodMart storefront - environment variables
# Local: copy to .env.local
# Production (Vercel): add the same names in Project Settings > Environment Variables, then redeploy
# NOTE: NEXT_PUBLIC_* values are baked in at build time - redeploy after changing them.
# =====================================================

# --- Backend API (no trailing slash) ---
# Local:       http://localhost:5000/api/v1
# Production:  https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# --- Optional: same-domain API proxy (no CORS needed) ---
# To use it set NEXT_PUBLIC_API_BASE_URL=/api/v1 and put your backend origin here:
# API_PROXY_TARGET=https://api.yourdomain.com

# --- Partner / admin dashboard ---
# Production: https://panel.yourdomain.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173

# --- This website ---
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Default city until the visitor picks one ---
NEXT_PUBLIC_DEFAULT_CITY=Karachi
